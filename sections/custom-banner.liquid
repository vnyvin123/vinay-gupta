{{ 'section-custom-banner.css' | asset_url | stylesheet_tag }}
<div class="custom-banner-section" style="background-color: {{ section.settings.bg_color }};">
  
  <!-- Background Artwork Images -->
  <div class="custom-banner-artwork">
    {% if section.settings.banner_image != blank %}
      <img src="{{ section.settings.banner_image | image_url: width: 1600 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" class="desktop-banner-image">
    {% endif %}
    {%- assign mobile_image = section.settings.banner_image_mobile | default: section.settings.banner_image -%}
    {% if mobile_image != blank %}
      <img src="{{ mobile_image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" class="mobile-banner-image">
    {% endif %}
  </div>

  <div class="custom-banner-container">
    
 
    <!-- Main Content Box -->
    <div class="custom-banner-content">
      {% if section.settings.heading != blank %}
        <h1 class="custom-banner-heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="custom-banner-desc">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <div class="custom-banner-action">
          <a href="{{ section.settings.button_link }}" class="custom-animated-btn black-btn">
            <span>{{ section.settings.button_text }}</span>
            <svg class="arrow-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Bottom Footer Tagline -->
    {% if section.settings.bottom_tagline != blank %}
      <div class="custom-banner-bottom-tagline">
        {{ section.settings.bottom_tagline | escape }}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-banner-wrapper",
  "settings": [
 
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Desktop Banner Artwork Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Mobile Banner Artwork Image",
      "info": "Optional. Falls back to desktop image if left blank."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading Text",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Text",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "bottom_tagline",
      "label": "Bottom Footer Tagline",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}