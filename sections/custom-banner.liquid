{{ 'section-custom-banner.css' | asset_url | stylesheet_tag }}


{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-banner-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top Center Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Top Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Desktop Banner Artwork Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Mobile Banner Artwork Image",
      "info": "Optional. Falls back to desktop image if left blank."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading Text",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Text",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "bottom_tagline",
      "label": "Bottom Footer Tagline",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %
